{
  "name": "packgod-browser",
  "version": "2.0.0",
  "description": "A chaotic, customizable Electron browser",
  "author": "tropical-express",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.packgod.browser",
    "productName": "Packgod Browser",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!node_modules/.cache/**/*"
    ],
    "extraResources": [
      "assets/**/*"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Network",
      "target": ["deb", "AppImage"]
    },
    "mac": {
      "target": ["dmg"]
    }
  }
}